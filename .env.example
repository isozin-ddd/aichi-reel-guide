# Public URL of the site (canonical, og:url, og:image, sitemap, robots.txt).
# Defaults to https://aichi-reel-guide.ghj87vy8mm.workers.dev when unset.
SITE_URL=https://aichi-reel-guide.ghj87vy8mm.workers.dev

# Cloudflare Web Analytics token (cookie-free). Leave empty to disable analytics.
PUBLIC_CF_ANALYTICS_TOKEN=

# Map tiles. The default is the OpenStreetMap standard tile server, which is fine for
# development and light use but has a strict usage policy. For production, switch to a
# provider whose terms allow your traffic (e.g. a paid/free-tier vector or raster plan)
# and update the attribution accordingly.
PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
PUBLIC_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
PUBLIC_MAP_TILE_MAX_ZOOM=19

# Set to "true" ONLY for preview/staging builds to include is_sample spots.
# Never set this on the production environment. Drafts are never built.
INCLUDE_SAMPLE_CONTENT=false

# Optional: contact email and the operator's social accounts (https URLs).
PUBLIC_CONTACT_EMAIL=
PUBLIC_SOCIAL_INSTAGRAM=
PUBLIC_SOCIAL_TIKTOK=
PUBLIC_SOCIAL_YOUTUBE=
