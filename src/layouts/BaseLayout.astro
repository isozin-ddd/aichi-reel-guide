---
import '@fontsource/cormorant-garamond/latin-300.css';
import '@fontsource/cormorant-garamond/latin-300-italic.css';
import '@fontsource-variable/jost/wght.css';
import '@fontsource/shippori-mincho/japanese-400.css';
import '~/styles/global.css';

import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import defaultOg from '~/assets/site/og-default.jpg';
import { ANALYTICS_TOKEN, SITE } from '~/config/site';
import { jsonLdString } from '~/lib/seo';

interface Props {
  /** Page title without the site name. */
  title: string;
  description: string;
  /** Path for canonical URL; defaults to the current path. */
  canonicalPath?: string;
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: unknown[];
  /** Use the bare title (home page). */
  bareTitle?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  ogImage = defaultOg,
  ogImageAlt = 'Next Stop Nagoya — How to get around Nagoya',
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  bareTitle = false,
} = Astro.props;

const fullTitle = bareTitle ? title : `${title} | ${SITE.name}`;
const path = canonicalPath ?? Astro.url.pathname;
const normalizedPath = path.endsWith('/') ? path : `${path}/`;
const canonical = new URL(normalizedPath, Astro.site).href;
const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const ogUrl = new URL(og.src, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f7f4ec" />
    <meta name="google-site-verification" content="tngdzqLedX0ix0Ije_nV6SXmkwncGqk1NsY88oABs70" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={jsonLdString(data)} />)}

    <script is:inline>
      // Show the alt text in place of any image that fails to load.
      (function () {
        function mark(img) {
          var frame = img.closest('.img-frame');
          if (frame) frame.classList.add('is-broken');
        }
        document.addEventListener(
          'error',
          function (e) {
            var t = e.target;
            if (t && t.tagName === 'IMG' && t.hasAttribute('data-fallback')) mark(t);
          },
          true,
        );
        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('img[data-fallback]').forEach(function (img) {
            if (img.complete && img.naturalWidth === 0 && img.getAttribute('loading') !== 'lazy') mark(img);
          });
        });
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <Header />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
    <script>
      // Slow fade-in for content entering the viewport. Elements already on
      // screen at load are left alone (so nothing delays the first paint), and
      // nothing animates for visitors who prefer reduced motion.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && 'IntersectionObserver' in window && items.length > 0) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              el.classList.add('reveal-in');
              el.classList.remove('reveal-pending');
              io.unobserve(el);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        for (const el of items) {
          if (el.getBoundingClientRect().top > window.innerHeight) {
            el.classList.add('reveal-pending');
            io.observe(el);
          }
        }
      }
    </script>
    {
      ANALYTICS_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: ANALYTICS_TOKEN })}
        />
      )
    }
  </body>
</html>
