---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import FramedImage from '~/components/FramedImage.astro';
import SpotGrid from '~/components/SpotGrid.astro';
import EmptyState from '~/components/EmptyState.astro';
import SectionHeading from '~/components/SectionHeading.astro';
import { getAreas, getPublishedSpots, type Area } from '~/lib/content';
import { absoluteUrl, breadcrumbJsonLd } from '~/lib/seo';

export const getStaticPaths = (async () => {
  const areas = await getAreas();
  return areas.map((area) => ({ params: { slug: area.id }, props: { area, areas } }));
}) satisfies GetStaticPaths;

interface Props {
  area: Area;
  areas: Area[];
}
const { area, areas } = Astro.props;
const a = area.data;
const spots = (await getPublishedSpots()).filter((s) => s.data.area.id === area.id);
const others = areas.filter((x) => x.id !== area.id);
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Areas', href: '/areas/' },
  { label: a.name, href: `/areas/${area.id}/` },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristDestination',
    name: `${a.name}, Aichi`,
    description: a.intro_en[0],
    url: absoluteUrl(`/areas/${area.id}/`, Astro.site),
    geo: { '@type': 'GeoCoordinates', latitude: a.latitude, longitude: a.longitude },
  },
  breadcrumbJsonLd(crumbs, Astro.site),
];
---

<BaseLayout
  title={`${a.name} Travel Guide — Things to Do in ${a.name}, Aichi`}
  description={`${a.tagline} Local videos and hand-picked spots in ${a.name}, Aichi Prefecture: what to see, where to eat and how to get there from Nagoya.`}
  ogImage={a.image}
  ogImageAlt={a.image_alt}
  jsonLd={jsonLd}
>
  <div class="container-page page-top">
    <Breadcrumbs items={crumbs} />
    <header class="mt-16 grid gap-12 md:mt-24 md:grid-cols-[5fr_7fr] md:items-end md:gap-16">
      <div class="md:pb-4">
        <p class="label label-gold">Area guide · <span lang="ja">{a.name_ja}</span></p>
        <h1 class="display-xl mt-6 md:mt-10">{a.name}</h1>
        <p class="text-body mt-6 md:mt-10">{a.tagline}</p>
      </div>
      <figure>
        <FramedImage
          src={a.image}
          alt={a.image_alt}
          sizes="(min-width: 1280px) 680px, (min-width: 768px) 55vw, calc(100vw - 48px)"
          widths={[480, 720, 960, 1280]}
          class="aspect-[4/5] md:aspect-[5/4]"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption class="label mt-4 text-right">{a.image_credit}</figcaption>
      </figure>
    </header>

    <div class="section grid gap-16 md:grid-cols-[7fr_4fr] md:gap-24">
      <div class="prose-guide max-w-xl" data-reveal>
        {a.intro_en.map((p) => <p>{p}</p>)}
      </div>
      {
        a.getting_there_en && (
          <aside class="self-start" data-reveal>
            <h2 class="label label-gold border-t border-line pt-5">Getting there</h2>
            <p class="text-body mt-6">{a.getting_there_en}</p>
          </aside>
        )
      }
    </div>

    <section class="section" aria-labelledby="spots-heading">
      <SectionHeading eyebrow="Where to go" title={`Spots in ${a.name}`} id="spots-heading" />
      {
        spots.length > 0 ? (
          <SpotGrid spots={spots} />
        ) : (
          <EmptyState title="New spots are being added soon">
            In the meantime, see <a href="/spots/" class="link-quiet text-ink">all spots</a>.
          </EmptyState>
        )
      }
    </section>

    <nav class="section" aria-labelledby="other-areas">
      <SectionHeading eyebrow="Other areas" id="other-areas" />
      <ul class="flex flex-wrap gap-x-10 gap-y-4">
        {
          others.map((o) => (
            <li>
              <a href={`/areas/${o.id}/`} class="font-display text-[1.75rem] text-ink no-underline transition-colors duration-500 hover:text-gold md:text-[2.25rem]">
                {o.data.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</BaseLayout>
