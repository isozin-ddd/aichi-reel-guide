---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import { getLookups, getPublishedSpots } from '~/lib/content';
import { MAP_TILES } from '~/config/site';
import { breadcrumbJsonLd } from '~/lib/seo';
import { priceLabel } from '~/lib/format';

const [spots, { areas, categories, areaById, categoryById }] = await Promise.all([getPublishedSpots(), getLookups()]);

const points = spots.map((s) => ({
  slug: s.id,
  name: s.data.name_en,
  lat: s.data.latitude,
  lng: s.data.longitude,
  area: s.data.area.id,
  areaName: areaById.get(s.data.area.id)!.data.name,
  category: s.data.category.id,
  categoryName: categoryById.get(s.data.category.id)!.data.name,
  summary: s.data.summary_en,
  price: priceLabel(s.data.price_level)?.symbol ?? null,
  sample: s.data.is_sample,
}));

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Map', href: '/map/' },
];
const selectClass =
  'h-11 w-full appearance-none rounded-[2px] border border-line bg-paper px-3 text-[0.9rem] text-ink focus:border-gold';
---

<BaseLayout
  title="Map of Aichi — Spots to Visit in Nagoya & Beyond"
  description="An interactive map of every spot in the Aichi Reel Guide. Filter by area and category, then tap a pin for local videos and travel tips."
  jsonLd={[breadcrumbJsonLd(crumbs, Astro.site)]}
>
  <div class="container-page pt-8 md:pt-12">
    <Breadcrumbs items={crumbs} />
    <header class="mt-6 flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow">Plan your days</p>
        <h1 class="mt-3 text-[3rem] md:text-[4.2rem]">Map</h1>
      </div>
      <form id="map-filters" class="grid w-full grid-cols-2 gap-3 md:w-auto md:min-w-[28rem]" aria-label="Filter map">
        <div>
          <label for="map-area" class="eyebrow mb-1.5 block !text-ink-soft">Area</label>
          <select id="map-area" class={selectClass}>
            <option value="">All areas</option>
            {areas.map((a) => <option value={a.id}>{a.data.name}</option>)}
          </select>
        </div>
        <div>
          <label for="map-category" class="eyebrow mb-1.5 block !text-ink-soft">Category</label>
          <select id="map-category" class={selectClass}>
            <option value="">All categories</option>
            {categories.map((c) => <option value={c.id}>{c.data.name}</option>)}
          </select>
        </div>
      </form>
    </header>

    <div class="relative mt-8">
      <div
        id="map"
        class="h-[68vh] min-h-[420px] w-full border border-line bg-sand"
        data-tile-url={MAP_TILES.url}
        data-tile-attribution={MAP_TILES.attribution}
        data-tile-max-zoom={MAP_TILES.maxZoom}
        role="region"
        aria-label="Map of spots in Aichi"
      >
        <noscript>
          <p class="p-6 text-sm text-ink-soft">The map needs JavaScript. Every spot is listed below.</p>
        </noscript>
      </div>
      <p id="map-count" class="mt-3 text-sm text-ink-soft" aria-live="polite">
        {points.length === 1 ? '1 spot' : `${points.length} spots`} on the map
      </p>
    </div>

    <section class="mt-14" aria-labelledby="list-heading">
      <h2 id="list-heading" class="text-[1.9rem]">All spots on the map</h2>
      {
        points.length === 0 ? (
          <p class="mt-4 text-ink-soft">
            No spots yet — they're on the way. Explore the <a href="/areas/" class="text-ink underline">area guides</a> meanwhile.
          </p>
        ) : (
          <ul class="mt-6 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3" id="map-list">
            {points.map((p) => (
              <li class="border-b border-line py-3" data-area={p.area} data-category={p.category}>
                <a href={`/spots/${p.slug}/`} class="font-display text-[1.3rem] text-ink no-underline hover:text-gold">
                  {p.name}
                </a>
                <span class="block text-xs tracking-wide text-ink-soft">
                  {p.areaName} · {p.categoryName}
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>

  <script type="application/json" id="map-data" set:html={JSON.stringify(points).replace(/</g, '\\u003c')} />
</BaseLayout>

<style is:global>
  .arg-pin {
    width: 30px;
    height: 30px;
    border-radius: 50% 50% 50% 0;
    background: var(--color-ink);
    border: 2px solid var(--color-paper);
    transform: rotate(-45deg);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.25);
  }
  .arg-pin::after {
    content: '';
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    background: var(--color-gold-soft);
  }
  .leaflet-container {
    font-family: var(--font-sans);
    background: var(--color-sand);
  }
  .leaflet-popup-content-wrapper {
    border-radius: 2px;
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .leaflet-popup-content {
    margin: 16px 18px;
    min-width: 200px;
  }
  .leaflet-container a.arg-popup-link {
    color: var(--color-paper);
  }
</style>

<script>
  import 'leaflet/dist/leaflet.css';
  import L from 'leaflet';

  interface Point {
    slug: string;
    name: string;
    lat: number;
    lng: number;
    area: string;
    areaName: string;
    category: string;
    categoryName: string;
    summary: string;
    price: string | null;
    sample: boolean;
  }

  const el = document.getElementById('map');
  const dataEl = document.getElementById('map-data');
  const areaSel = document.querySelector<HTMLSelectElement>('#map-area');
  const catSel = document.querySelector<HTMLSelectElement>('#map-category');
  const count = document.getElementById('map-count');

  function popupContent(p: Point): HTMLElement {
    const root = document.createElement('div');
    const meta = document.createElement('p');
    meta.className = 'text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-ink-soft !m-0';
    meta.textContent = [p.areaName, p.categoryName, p.price].filter(Boolean).join(' · ');
    const title = document.createElement('p');
    title.className = 'font-display text-[1.35rem] leading-tight !mt-1 !mb-0';
    title.textContent = p.name;
    const summary = document.createElement('p');
    summary.className = 'text-[0.85rem] leading-snug text-ink-soft !mt-2 !mb-3';
    summary.textContent = p.summary;
    const link = document.createElement('a');
    link.href = `/spots/${encodeURIComponent(p.slug)}/`;
    link.className = 'arg-popup-link inline-block bg-ink px-3 py-2 text-[0.7rem] font-semibold uppercase tracking-[0.12em] no-underline';
    link.textContent = 'View details →';
    root.append(meta, title, summary, link);
    return root;
  }

  if (el && dataEl) {
    try {
      const points: Point[] = JSON.parse(dataEl.textContent || '[]');
      const map = L.map(el, { scrollWheelZoom: false, zoomControl: true }).setView([35.05, 137.05], 9);
      L.tileLayer(el.dataset.tileUrl!, {
        attribution: el.dataset.tileAttribution,
        maxZoom: Number(el.dataset.tileMaxZoom) || 19,
      }).addTo(map);
      map.on('focus', () => map.scrollWheelZoom.enable());
      map.on('blur', () => map.scrollWheelZoom.disable());

      const icon = L.divIcon({ className: '', html: '<div class="arg-pin"></div>', iconSize: [30, 30], iconAnchor: [15, 30], popupAnchor: [0, -30] });
      const markers = points.map((p) => ({
        p,
        marker: L.marker([p.lat, p.lng], { icon, title: p.name, alt: p.name, keyboard: true }).bindPopup(popupContent(p)),
      }));
      const layer = L.layerGroup().addTo(map);

      const params = new URLSearchParams(location.search);
      if (areaSel && [...areaSel.options].some((o) => o.value === params.get('area'))) areaSel.value = params.get('area')!;
      if (catSel && [...catSel.options].some((o) => o.value === params.get('category'))) catSel.value = params.get('category')!;

      const apply = (fit: boolean) => {
        const a = areaSel?.value ?? '';
        const c = catSel?.value ?? '';
        layer.clearLayers();
        const visible = markers.filter(({ p }) => (!a || p.area === a) && (!c || p.category === c));
        visible.forEach(({ marker }) => layer.addLayer(marker));
        document.querySelectorAll<HTMLElement>('#map-list > li').forEach((li) => {
          li.hidden = !((!a || li.dataset.area === a) && (!c || li.dataset.category === c));
        });
        if (count) count.textContent = `${visible.length === 1 ? '1 spot' : `${visible.length} spots`} on the map`;
        if (fit && visible.length > 0) {
          const bounds = L.latLngBounds(visible.map(({ p }) => [p.lat, p.lng] as [number, number]));
          map.fitBounds(bounds, { padding: [48, 48], maxZoom: 14 });
        }
        const next = new URLSearchParams();
        if (a) next.set('area', a);
        if (c) next.set('category', c);
        history.replaceState(null, '', next.toString() ? `?${next}` : location.pathname);
      };
      areaSel?.addEventListener('change', () => apply(true));
      catSel?.addEventListener('change', () => apply(true));
      apply(points.length > 0);
    } catch (err) {
      console.error(err);
      el.innerHTML = '<p class="p-6 text-sm text-ink-soft">Sorry, the map could not be loaded. Every spot is listed below.</p>';
    }
  }
</script>
