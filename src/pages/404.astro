---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="Sorry, we couldn't find that page." noindex canonicalPath="/404/">
  <div class="container-page section text-center">
    <p class="label label-gold">404</p>
    <h1 class="display-lg mx-auto mt-8 max-w-3xl">We couldn't find that page</h1>
    <p class="text-body mx-auto mt-8 max-w-sm">
      It may have moved, or the spot may no longer be listed. Try one of these instead.
    </p>
    <div class="mt-12 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/" class="btn btn-primary">Home</a>
      <a href="/spots/" class="btn btn-ghost">All spots</a>
      <a href="/map/" class="btn btn-ghost">Map</a>
    </div>
  </div>
</BaseLayout>
