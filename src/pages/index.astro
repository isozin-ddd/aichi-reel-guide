---
import BaseLayout from '~/layouts/BaseLayout.astro';
import FramedImage from '~/components/FramedImage.astro';
import SectionHeading from '~/components/SectionHeading.astro';
import SpotGrid from '~/components/SpotGrid.astro';
import EmptyState from '~/components/EmptyState.astro';
import hero from '~/assets/site/hero.jpg';
import { getAreas, getCategories, getPublishedSpots } from '~/lib/content';
import { SITE } from '~/config/site';
import { absoluteUrl } from '~/lib/seo';

const [spots, areas, categories] = await Promise.all([getPublishedSpots(), getAreas(), getCategories()]);
const featured = spots.filter((s) => s.data.featured).slice(0, 6);
const pad = (n: number) => String(n).padStart(2, '0');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    description: SITE.description,
    url: absoluteUrl('/', Astro.site),
    inLanguage: 'en',
  },
];
---

<BaseLayout
  title="Aichi Reel Guide — Discover Aichi through local videos"
  bareTitle
  description="Your English guide to Nagoya and Aichi, Japan, told through short videos by local creators. Find cafes, castles, crafts, nature and hidden gems — with maps and travel tips."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="container-page grid gap-10 md:grid-cols-[5fr_7fr] md:items-end md:gap-16 md:pt-16">
    <div class="md:pb-4">
      <p class="label label-gold">Aichi, Japan</p>
      <h1 class="display-xl mt-5 md:mt-10">Discover<br class="hidden md:block" /> Aichi</h1>
      <p class="text-body mt-6 max-w-sm md:mt-10" data-hero-lede>
        Short local videos and practical tips for exploring Nagoya and beyond.
      </p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap md:mt-12">
        <a href="/spots/" class="btn btn-primary w-full sm:w-auto">Explore Spots</a>
        <a href="/map/" class="btn btn-ghost w-full sm:w-auto">Explore Map</a>
      </div>
    </div>
    <FramedImage
      src={hero}
      alt="Illustration of a castle above green hills and a calm bay under a golden sun"
      sizes="(min-width: 1280px) 680px, (min-width: 768px) 55vw, 100vw"
      widths={[480, 720, 960, 1280, 1600]}
      class="order-first -mx-6 aspect-[4/3] md:order-none md:mx-0 md:aspect-[5/4]"
      loading="eager"
      fetchpriority="high"
    />
  </section>

  <!-- Featured -->
  <section class="container-page section" aria-labelledby="featured-heading">
    <SectionHeading eyebrow="Editor's picks" title="Featured spots" id="featured-heading" href="/spots/" linkLabel="All spots" />
    {
      featured.length > 0 ? (
        <SpotGrid spots={featured} />
      ) : (
        <EmptyState title="New spots are being added soon">
          In the meantime, start planning with the areas below.
        </EmptyState>
      )
    }
  </section>

  <!-- Categories -->
  <section class="container-page section" aria-labelledby="categories-heading">
    <SectionHeading eyebrow="Browse by" title="Category" id="categories-heading" />
    <ul class="grid border-t border-line sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((c, i) => (
          <li class="border-b border-line sm:odd:border-r lg:border-r lg:[&:nth-child(3n)]:border-r-0" data-reveal>
            <a
              href={`/categories/${c.id}/`}
              class="group flex items-baseline gap-5 px-1 py-7 no-underline sm:px-8 md:py-12"
            >
              <span class="label label-gold">{pad(i + 1)}</span>
              <span class="font-display text-[1.75rem] leading-tight transition-colors duration-500 group-hover:text-gold md:text-[2.25rem]">
                {c.data.name}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Areas -->
  <section class="container-page section" aria-labelledby="areas-heading">
    <SectionHeading eyebrow="Where to go" title="Areas" id="areas-heading" href="/areas/" linkLabel="All areas" />
    <ul class="border-t border-line">
      {
        areas.map((a) => (
          <li class="border-b border-line" data-reveal>
            <a
              href={`/areas/${a.id}/`}
              class="group grid grid-cols-[1fr_auto] items-baseline gap-x-6 py-7 no-underline md:grid-cols-[1fr_1.4fr_auto] md:py-10"
            >
              <span class="font-display text-[2rem] leading-none transition-colors duration-500 group-hover:text-gold md:text-[3rem]">
                {a.data.name}
              </span>
              <span class="text-body col-span-2 row-start-2 mt-2 md:col-span-1 md:col-start-2 md:row-start-1 md:mt-0">
                {a.data.tagline}
              </span>
              <span class="label col-start-2 row-start-1 md:col-start-3" lang="ja">
                {a.data.name_ja}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Why videos -->
  <section class="container-page section" aria-labelledby="why-heading">
    <SectionHeading eyebrow="About the guide" />
    <div class="grid gap-10 md:grid-cols-[5fr_7fr] md:gap-16" data-reveal>
      <h2 id="why-heading" class="display-md">Why videos?</h2>
      <div class="max-w-lg">
        <p class="text-body">
          Fifteen seconds of video says more than a page of adjectives. Any clip we feature is shared with its
          creator's permission.
        </p>
        <p class="mt-8"><a href="/about/" class="label link-quiet !text-ink">More about the guide</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
