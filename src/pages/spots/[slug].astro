---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import FramedImage from '~/components/FramedImage.astro';
import Icon from '~/components/Icon.astro';
import RouteCard from '~/components/RouteCard.astro';
import ShareButtons from '~/components/ShareButtons.astro';
import SpotGrid from '~/components/SpotGrid.astro';
import SectionHeading from '~/components/SectionHeading.astro';
import VideoSection from '~/components/video/VideoSection.astro';
import { displayableVideos, getLookups, getPublishedSpots, type Spot } from '~/lib/content';
import { formatDate, googleMapsUrl, priceLabel, STATUS_LABELS } from '~/lib/format';
import { absoluteUrl, breadcrumbJsonLd } from '~/lib/seo';
import { getImage } from 'astro:assets';

export const getStaticPaths = (async () => {
  const spots = await getPublishedSpots();
  return spots.map((spot) => ({ params: { slug: spot.id }, props: { spot, all: spots } }));
}) satisfies GetStaticPaths;

interface Props {
  spot: Spot;
  all: Spot[];
}

const { spot, all } = Astro.props;
const d = spot.data;
const { areaById, categoryById } = await getLookups();
const area = areaById.get(d.area.id)!;
const category = categoryById.get(d.category.id)!;
const price = priceLabel(d.price_level);
const status = STATUS_LABELS[d.status];
const mapsUrl = googleMapsUrl(d);
const videos = displayableVideos(spot);
const nearby = all.filter((s) => s.id !== spot.id && s.data.area.id === d.area.id).slice(0, 3);
const pageUrl = absoluteUrl(`/spots/${spot.id}/`, Astro.site);

const crumbs = [
  { label: 'Home', href: '/' },
  { label: area.data.name, href: `/areas/${area.id}/` },
  { label: d.name_en, href: `/spots/${spot.id}/` },
];

// Hours, access and prices now live in the main column, so the sidebar keeps only these.
const facts: { label: string; value: string | null; href?: string }[] = [
  { label: 'Address', value: d.address },
  { label: 'Website', value: d.official_url, href: d.official_url ?? undefined },
];

const rating = d.visitor_rating;
const priceText = price ? (d.price_level === 0 ? price.text : `${price.symbol} · ${price.text}`) : null;
const admissionText = d.admission_en ?? priceText;

// At-a-glance facts under the title, in the order visitors care about.
const shortHours = d.opening_hours?.split(/[.(]/)[0]?.trim() || null;
const shortAdmission = d.admission_en?.split(/[.;(]/)[0]?.trim() || priceText;
const quickFacts = [
  { icon: 'star', label: 'For visitors', value: rating ? `${rating.stars} / 5` : null },
  {
    icon: 'train',
    label: d.directions ? `From ${d.directions.from_en.replace(/ Station$/, '')}` : 'Station',
    value: d.directions ? `${d.directions.minutes} min · ¥${d.directions.fare_yen}` : d.nearest_station?.split('(')[0]?.trim() || null,
    href: d.directions ? '#getting-there' : undefined,
  },
  { icon: 'clock', label: 'Hours', value: shortHours },
  { icon: 'receipt', label: 'Admission', value: shortAdmission },
].filter((f) => f.value) as { icon: 'star' | 'clock' | 'receipt' | 'train'; label: string; value: string; href?: string }[];
const [leadParagraph, ...moreParagraphs] = d.description_en;

const TRAVELER_LABELS = {
  english_menu: ['English menu available', 'No English menu'],
  cards_accepted: ['Cards accepted', 'Cash only'],
  reservation: ['Reservation recommended', 'No reservation needed'],
  vegetarian: ['Vegetarian options', 'No vegetarian options'],
  tax_free: ['Tax-free shopping', 'Not tax-free'],
} as const;
const traveler = (Object.keys(TRAVELER_LABELS) as (keyof typeof TRAVELER_LABELS)[])
  .map((key) => ({ key, value: d.traveler_info[key] }))
  .filter((t): t is { key: keyof typeof TRAVELER_LABELS; value: boolean } => t.value !== null)
  .map(({ key, value }) => ({ yes: value, text: TRAVELER_LABELS[key][value ? 0 : 1] }));

const ogImage = await getImage({ src: d.image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const isRestaurant = category.id === 'food-cafes';
const placeJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': isRestaurant ? 'Restaurant' : 'TouristAttraction',
  name: d.name_en,
  ...(d.name_ja ? { alternateName: d.name_ja } : {}),
  description: d.summary_en,
  url: pageUrl,
  image: absoluteUrl(ogImage.src, Astro.site),
  geo: { '@type': 'GeoCoordinates', latitude: d.latitude, longitude: d.longitude },
  address: {
    '@type': 'PostalAddress',
    ...(d.address ? { streetAddress: d.address } : {}),
    addressLocality: area.data.name,
    addressRegion: 'Aichi',
    addressCountry: 'JP',
  },
  hasMap: mapsUrl,
  ...(d.official_url ? { sameAs: [d.official_url] } : {}),
  ...(isRestaurant && price && d.price_level! > 0 ? { priceRange: price.symbol } : {}),
  ...(!isRestaurant && d.price_level === 0 ? { isAccessibleForFree: true } : {}),
  ...(isRestaurant && d.traveler_info.reservation !== null
    ? { acceptsReservations: d.traveler_info.reservation }
    : {}),
};

const title = `${d.name_en} — ${category.data.name} in ${area.data.name}`;
const description = `${d.summary_en} Local videos, opening hours, access and traveller tips for ${d.name_en} in ${area.data.name}, Aichi.`.slice(0, 300);
---

<BaseLayout
  title={title}
  description={description}
  ogImage={d.image}
  ogImageAlt={d.image_alt}
  ogType="article"
  noindex={d.is_sample}
  jsonLd={[placeJsonLd, breadcrumbJsonLd(crumbs, Astro.site)]}
>
  <article class="page-top">
    <div class="container-page">
      <Breadcrumbs items={crumbs} />

      {
        d.is_sample && (
          <p class="mt-10 border-y border-line py-4 text-[0.875rem] text-ink-soft" role="note">
            <span class="label label-gold mr-3">Sample</span>
            This place is fictional and only previews the design. It never appears in the production build.
          </p>
        )
      }
    </div>

    <!-- Photo first: edge to edge on phones, framed on larger screens -->
    <figure class="mt-8 md:mx-auto md:mt-14 md:max-w-[80rem] md:px-12">
      <FramedImage
        src={d.image}
        alt={d.image_alt}
        position={d.image_focus}
        sizes="(min-width: 1280px) 1184px, (min-width: 768px) calc(100vw - 96px), 100vw"
        widths={[480, 800, 1184, 1600]}
        class="aspect-[4/5] md:aspect-[16/9]"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="label mt-3 px-6 text-right md:px-0">{d.image_credit}</figcaption>
    </figure>

    <div class="container-page">
    <header class="mt-12 max-w-4xl md:mt-20">
      <p class="label label-gold">
        <a href={`/categories/${category.id}/`} class="no-underline hover:text-ink">{category.data.name}</a>
        <span aria-hidden="true" class="mx-2">·</span>
        <a href={`/areas/${area.id}/`} class="no-underline hover:text-ink">{area.data.name}</a>
      </p>
      <h1 class="display-lg mt-5 md:mt-8">{d.name_en}</h1>
      {d.name_ja && <p class="label mt-5" lang="ja">{d.name_ja}</p>}
      {status && <p class="label label-gold mt-5">{status}</p>}
    </header>

    {
      quickFacts.length > 0 && (
        <ul
          class:list={[
            'mt-10 grid border-y border-line md:mt-14 md:max-w-4xl',
            quickFacts.length === 4 ? 'grid-cols-2 md:grid-cols-4' : 'grid-cols-3',
          ]}
          aria-label="At a glance"
        >
          {quickFacts.map((f, i) => (
            <li
              class:list={[
                'py-5 pr-3',
                quickFacts.length === 4
                  ? [i % 2 === 1 && 'border-l border-line pl-4', i >= 2 && 'border-t border-line md:border-t-0', i === 2 && 'md:border-l md:pl-4']
                  : i > 0 && 'border-l border-line pl-4',
              ]}
            >
              <Icon name={f.icon} size={16} strokeWidth={1.4} class="text-gold" />
              <p class="label mt-3">{f.label}</p>
              {f.href ? (
                <a href={f.href} class="mt-1 block text-[0.875rem] leading-snug">
                  {f.value}
                </a>
              ) : (
                <p class="mt-1 text-[0.875rem] leading-snug">{f.value}</p>
              )}
            </li>
          ))}
        </ul>
      )
    }
    </div>

    {
      d.gallery.length > 0 && (
        <div
          class="mt-12 flex snap-x snap-mandatory gap-3 overflow-x-auto px-6 pb-2 md:mx-auto md:mt-16 md:max-w-[80rem] md:gap-6 md:px-12"
          aria-label={`More photos of ${d.name_en}`}
          role="region"
          tabindex="0"
        >
          {d.gallery.map((g) => (
            <figure class="w-[78%] shrink-0 snap-start sm:w-[45%] lg:w-[31%]">
              <FramedImage src={g.image} alt={g.alt} sizes="(min-width: 1024px) 368px, 78vw" widths={[360, 560, 800]} aspect="4 / 5" />
              <figcaption class="label mt-3">{g.credit}</figcaption>
            </figure>
          ))}
        </div>
      )
    }

    <div class="container-page">

    <div class="section grid gap-20 !pt-24 md:grid-cols-[7fr_4fr] md:gap-24 md:!pt-32">
      <div>
        {
          rating && (
            <section aria-labelledby="rating-heading" data-reveal>
              <h2 id="rating-heading" class="label label-gold border-t border-line pt-5">
                How much we recommend it
              </h2>
              <p class="mt-6 flex items-baseline gap-4">
                <span class="text-[1.75rem] leading-none tracking-[0.15em] text-gold" aria-hidden="true">
                  {'★'.repeat(rating.stars)}<span class="text-line">{'★'.repeat(5 - rating.stars)}</span>
                </span>
                <span class="font-display text-[1.75rem] leading-none md:text-[2rem]">
                  {rating.stars}<span class="text-ink-soft"> / 5</span>
                </span>
                <span class="sr-only">{rating.stars} out of 5 for overseas visitors</span>
              </p>
              <ul class="mt-6">
                {rating.reasons_en.map((r) => (
                  <li class="border-b border-line py-4 text-[0.9375rem]">{r}</li>
                ))}
              </ul>
            </section>
          )
        }

        {
          (d.directions || d.access_en || d.nearest_station) && (
            <section id="getting-there" class="mt-14 scroll-mt-8 md:mt-20" aria-labelledby="access-heading" data-reveal>
              <h2 id="access-heading" class="label label-gold border-t border-line pt-5">Getting there by public transport</h2>
              {d.directions ? (
                <div class="mt-6">
                  <RouteCard directions={d.directions} destination={d.name_en} />
                </div>
              ) : (
                <>
                  {d.nearest_station && <p class="label mt-6 !text-ink">{d.nearest_station}</p>}
                  {d.access_en && <p class="mt-3 max-w-xl text-[0.9375rem]">{d.access_en}</p>}
                </>
              )}
            </section>
          )
        }

        {
          (d.opening_hours || d.closed_days) && (
            <section class="mt-14 md:mt-20" aria-labelledby="hours-heading" data-reveal>
              <h2 id="hours-heading" class="label label-gold border-t border-line pt-5">Opening hours</h2>
              {d.opening_hours && <p class="mt-6 max-w-xl text-[0.9375rem]">{d.opening_hours}</p>}
              {d.closed_days && (
                <p class="mt-3 max-w-xl text-[0.9375rem] text-ink-soft">Closed: {d.closed_days}</p>
              )}
            </section>
          )
        }

        {
          admissionText && (
            <section class="mt-14 md:mt-20" aria-labelledby="admission-heading" data-reveal>
              <h2 id="admission-heading" class="label label-gold border-t border-line pt-5">Admission</h2>
              <p class="mt-6 max-w-xl text-[0.9375rem]">{admissionText}</p>
            </section>
          )
        }

        {
          d.route_en.length > 0 && (
            <section class="mt-14 md:mt-20" aria-labelledby="route-heading" data-reveal>
              <h2 id="route-heading" class="label label-gold border-t border-line pt-5">How to see it</h2>
              <ol class="mt-6">
                {d.route_en.map((step, i) => (
                  <li class="flex gap-6 border-b border-line py-5">
                    <span class="label label-gold pt-1">{String(i + 1).padStart(2, '0')}</span>
                    <div>
                      <h3 class="font-display text-[1.375rem] leading-snug">{step.title_en}</h3>
                      <p class="mt-2 text-[0.9375rem]">{step.text_en}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {
          !rating && d.highlights_en.length > 0 && (
            <section class="mt-14 md:mt-20" aria-labelledby="highlights-heading" data-reveal>
              <h2 id="highlights-heading" class="label label-gold border-t border-line pt-5">
                Why we love it
              </h2>
              <ol class="mt-6">
                {d.highlights_en.map((h, i) => (
                  <li class="flex gap-6 border-b border-line py-5 text-[0.9375rem]">
                    <span class="label label-gold pt-0.5">{String(i + 1).padStart(2, '0')}</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        <section class="mt-14 md:mt-20" aria-labelledby="about-heading" data-reveal>
          <h2 id="about-heading" class="label label-gold border-t border-line pt-5">About {d.name_en}</h2>
          <p class="font-display mt-6 text-[1.5rem] leading-[1.4] italic md:text-[1.75rem]">{d.summary_en}</p>
          <div class="prose-guide mt-8 max-w-xl">
            <p>{leadParagraph}</p>
            {
              moreParagraphs.length > 0 && (
                <details class="group mt-6">
                  <summary class="label inline-flex cursor-pointer list-none items-center gap-2 border-b border-line pb-1 !text-ink hover:border-gold [&::-webkit-details-marker]:hidden">
                    <span class="group-open:hidden">Read more</span>
                    <span class="hidden group-open:inline">Show less</span>
                  </summary>
                  <div class="mt-6">
                    {moreParagraphs.map((p) => (
                      <p>{p}</p>
                    ))}
                  </div>
                </details>
              )
            }
          </div>
        </section>

        <VideoSection videos={videos} spotName={d.name_en} />
      </div>

      <aside class="md:sticky md:top-10 md:self-start" aria-labelledby="facts-heading" data-reveal>
        <h2 id="facts-heading" class="label label-gold border-t border-line pt-5">Good to know</h2>
        <dl class="mt-6">
          {
            facts
              .filter((f) => f.value)
              .map((f) => (
                <div class="border-b border-line py-4">
                  <dt class="label">{f.label}</dt>
                  <dd class="mt-1 text-[0.9375rem] break-words">
                    {f.href ? (
                      <a href={f.href} target="_blank" rel="noopener" class="link-quiet">
                        {new URL(f.href).hostname.replace(/^www\./, '')}
                      </a>
                    ) : (
                      f.value
                    )}
                  </dd>
                </div>
              ))
          }
        </dl>

        {
          traveler.length > 0 && (
            <>
              <h3 class="label mt-10">For travellers</h3>
              <ul class="mt-4 space-y-2 text-[0.9375rem]">
                {traveler.map((t) => (
                  <li class="flex items-center gap-3">
                    <Icon name={t.yes ? 'check' : 'x'} size={14} class={t.yes ? 'text-gold' : 'text-ink-soft'} strokeWidth={1.6} />
                    <span>{t.text}</span>
                  </li>
                ))}
              </ul>
            </>
          )
        }

        <a href={mapsUrl} target="_blank" rel="noopener" class="btn btn-primary mt-10 w-full">Open in Google Maps</a>

        <p class="mt-6 text-[0.8125rem] leading-[1.8] text-ink-soft">
          Last checked {formatDate(d.last_verified_at)}. Details change, so confirm before you go.
        </p>

        <div class="mt-10 border-t border-line pt-6">
          <ShareButtons url={pageUrl} title={d.name_en} />
        </div>
      </aside>
    </div>

    </div>

    {
      nearby.length > 0 && (
        <section class="container-page section" aria-labelledby="nearby-heading">
          <SectionHeading eyebrow="While you're there" title={`More in ${area.data.name}`} id="nearby-heading" />
          <SpotGrid spots={nearby} />
        </section>
      )
    }
  </article>
</BaseLayout>
