---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import SpotGrid from '~/components/SpotGrid.astro';
import EmptyState from '~/components/EmptyState.astro';
import Icon from '~/components/Icon.astro';
import { getAreas, getCategories, getPublishedSpots } from '~/lib/content';
import { breadcrumbJsonLd } from '~/lib/seo';

const [spots, areas, categories] = await Promise.all([getPublishedSpots(), getAreas(), getCategories()]);
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Spots', href: '/spots/' },
];
const selectClass =
  'h-12 w-full appearance-none rounded-[2px] border border-line bg-paper px-4 pr-10 text-[0.95rem] text-ink focus:border-gold';
---

<BaseLayout
  title="All Spots in Aichi & Nagoya"
  description="Browse every spot in the Aichi Reel Guide: cafes, castles, shrines, pottery classes, markets and nature in Nagoya and across Aichi — each with local videos and practical tips."
  jsonLd={[breadcrumbJsonLd(crumbs, Astro.site)]}
>
  <div class="container-page pt-8 md:pt-12">
    <Breadcrumbs items={crumbs} />
    <header class="mt-6 max-w-2xl">
      <p class="eyebrow">The guide</p>
      <h1 class="mt-3 text-[3rem] md:text-[4.2rem]">All spots</h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">
        Search by name or mood, or narrow things down by area and category.
      </p>
    </header>

    <form
      id="spot-filters"
      class="mt-10 grid gap-3 border-y border-line py-5 md:grid-cols-[1.6fr_1fr_1fr_auto] md:items-end"
      role="search"
      action="/spots/"
      method="get"
    >
      <div>
        <label for="q" class="eyebrow mb-2 block !text-ink-soft">Search</label>
        <div class="relative">
          <Icon name="search" size={18} class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-ink-soft" />
          <input
            id="q"
            name="q"
            type="search"
            autocomplete="off"
            placeholder="Try “coffee”, “castle”, “pottery”…"
            class="h-12 w-full rounded-[2px] border border-line bg-paper pr-4 pl-11 text-[0.95rem] text-ink placeholder:text-ink-soft/80 focus:border-gold"
          />
        </div>
      </div>
      <div>
        <label for="area" class="eyebrow mb-2 block !text-ink-soft">Area</label>
        <select id="area" name="area" class={selectClass}>
          <option value="">All areas</option>
          {areas.map((a) => <option value={a.id}>{a.data.name}</option>)}
        </select>
      </div>
      <div>
        <label for="category" class="eyebrow mb-2 block !text-ink-soft">Category</label>
        <select id="category" name="category" class={selectClass}>
          <option value="">All categories</option>
          {categories.map((c) => <option value={c.id}>{c.data.name}</option>)}
        </select>
      </div>
      <button type="reset" class="btn btn-ghost h-12 min-h-0">Reset</button>
    </form>

    <p id="result-count" class="mt-6 text-sm text-ink-soft" aria-live="polite">
      {spots.length === 1 ? '1 spot' : `${spots.length} spots`}
    </p>

    <section class="mt-8" aria-label="Spot results">
      {
        spots.length > 0 ? (
          <SpotGrid spots={spots} headingLevel="h2" eagerCount={2} />
        ) : (
          <EmptyState title="New spots are on the way">
            We're filming with local creators right now. Check back soon, or start with our{' '}
            <a href="/areas/" class="text-ink underline">area guides</a>.
          </EmptyState>
        )
      }
      <EmptyState id="no-results" title="No spots match" hidden>
        Try a different word, or <button type="button" class="text-ink underline" data-clear>clear all filters</button>.
      </EmptyState>
    </section>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#spot-filters');
  const q = document.querySelector<HTMLInputElement>('#q');
  const area = document.querySelector<HTMLSelectElement>('#area');
  const category = document.querySelector<HTMLSelectElement>('#category');
  const count = document.querySelector<HTMLElement>('#result-count');
  const empty = document.querySelector<HTMLElement>('#no-results');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-spot-card]'));

  if (form && q && area && category && count && empty) {
    const optionValues = (s: HTMLSelectElement) => Array.from(s.options).map((o) => o.value);
    const params = new URLSearchParams(location.search);
    q.value = (params.get('q') ?? '').slice(0, 100);
    const a = params.get('area') ?? '';
    const c = params.get('category') ?? '';
    if (optionValues(area).includes(a)) area.value = a;
    if (optionValues(category).includes(c)) category.value = c;

    const apply = () => {
      const terms = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const card of cards) {
        const text = card.dataset.search ?? '';
        const match =
          (!area.value || card.dataset.area === area.value) &&
          (!category.value || card.dataset.category === category.value) &&
          terms.every((t) => text.includes(t));
        card.hidden = !match;
        if (match) shown++;
      }
      count.textContent = shown === 1 ? '1 spot' : `${shown} spots`;
      empty.hidden = !(cards.length > 0 && shown === 0);

      const next = new URLSearchParams();
      if (q.value.trim()) next.set('q', q.value.trim());
      if (area.value) next.set('area', area.value);
      if (category.value) next.set('category', category.value);
      const qs = next.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      apply();
    });
    form.addEventListener('input', apply);
    form.addEventListener('change', apply);
    form.addEventListener('reset', () => setTimeout(apply, 0));
    empty.querySelector('[data-clear]')?.addEventListener('click', () => {
      form.reset();
      q.focus();
    });
    apply();
  }
</script>
