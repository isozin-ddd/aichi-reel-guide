---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import SpotGrid from '~/components/SpotGrid.astro';
import EmptyState from '~/components/EmptyState.astro';
import { getAreas, getCategories, getPublishedSpots } from '~/lib/content';
import { breadcrumbJsonLd } from '~/lib/seo';

const [spots, areas, categories] = await Promise.all([getPublishedSpots(), getAreas(), getCategories()]);
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Spots', href: '/spots/' },
];
---

<BaseLayout
  title="All Spots in Aichi & Nagoya"
  description="Browse every spot in Next Stop Nagoya: cafes, castles, shrines, pottery classes, markets and nature in Nagoya and across Aichi — each with local videos and practical tips."
  jsonLd={[breadcrumbJsonLd(crumbs, Astro.site)]}
>
  <div class="container-page page-top">
    <Breadcrumbs items={crumbs} />
    <header class="mt-16 max-w-3xl md:mt-24">
      <p class="label label-gold">The guide</p>
      <h1 class="display-lg mt-6 md:mt-10">All spots</h1>
    </header>

    <form
      id="spot-filters"
      class="mt-16 grid gap-8 md:mt-24 md:grid-cols-[1.6fr_1fr_1fr_auto] md:items-end md:gap-10"
      role="search"
      action="/spots/"
      method="get"
    >
      <div>
        <label for="q" class="label block">Search</label>
        <input id="q" name="q" type="search" autocomplete="off" placeholder="Coffee, castle, pottery…" class="field placeholder:text-ink-soft" />
      </div>
      <div>
        <label for="area" class="label block">Area</label>
        <select id="area" name="area" class="field">
          <option value="">All areas</option>
          {areas.map((a) => <option value={a.id}>{a.data.name}</option>)}
        </select>
      </div>
      <div>
        <label for="category" class="label block">Category</label>
        <select id="category" name="category" class="field">
          <option value="">All categories</option>
          {categories.map((c) => <option value={c.id}>{c.data.name}</option>)}
        </select>
      </div>
      <button type="reset" class="label link-quiet justify-self-start pb-3 !text-ink md:justify-self-end">Reset</button>
    </form>

    <p id="result-count" class="label mt-12 border-t border-line pt-5 md:mt-16" aria-live="polite">
      {spots.length === 1 ? '1 spot' : `${spots.length} spots`}
    </p>

    <section class="mt-12 md:mt-20" aria-label="Spot results">
      {
        spots.length > 0 ? (
          <SpotGrid spots={spots} headingLevel="h2" eagerCount={1} />
        ) : (
          <EmptyState title="New spots are being added soon">
            In the meantime, start with the{' '}
            <a href="/areas/" class="link-quiet text-ink">area guides</a>.
          </EmptyState>
        )
      }
      <EmptyState id="no-results" title="Nothing matches" hidden>
        Try another word, or <button type="button" class="link-quiet text-ink" data-clear>clear the filters</button>.
      </EmptyState>
    </section>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#spot-filters');
  const q = document.querySelector<HTMLInputElement>('#q');
  const area = document.querySelector<HTMLSelectElement>('#area');
  const category = document.querySelector<HTMLSelectElement>('#category');
  const count = document.querySelector<HTMLElement>('#result-count');
  const empty = document.querySelector<HTMLElement>('#no-results');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-spot-card]'));

  if (form && q && area && category && count && empty) {
    const optionValues = (s: HTMLSelectElement) => Array.from(s.options).map((o) => o.value);
    const params = new URLSearchParams(location.search);
    q.value = (params.get('q') ?? '').slice(0, 100);
    const a = params.get('area') ?? '';
    const c = params.get('category') ?? '';
    if (optionValues(area).includes(a)) area.value = a;
    if (optionValues(category).includes(c)) category.value = c;

    const apply = () => {
      const terms = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const card of cards) {
        const text = card.dataset.search ?? '';
        const match =
          (!area.value || card.dataset.area === area.value) &&
          (!category.value || card.dataset.category === category.value) &&
          terms.every((t) => text.includes(t));
        card.hidden = !match;
        if (match) shown++;
      }
      count.textContent = shown === 1 ? '1 spot' : `${shown} spots`;
      empty.hidden = !(cards.length > 0 && shown === 0);

      const next = new URLSearchParams();
      if (q.value.trim()) next.set('q', q.value.trim());
      if (area.value) next.set('area', area.value);
      if (category.value) next.set('category', category.value);
      const qs = next.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      apply();
    });
    form.addEventListener('input', apply);
    form.addEventListener('change', apply);
    form.addEventListener('reset', () => setTimeout(apply, 0));
    empty.querySelector('[data-clear]')?.addEventListener('click', () => {
      form.reset();
      q.focus();
    });
    apply();
  }
</script>
