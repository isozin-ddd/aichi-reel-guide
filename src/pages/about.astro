---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import { SITE } from '~/config/site';
import { breadcrumbJsonLd } from '~/lib/seo';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
];
---

<BaseLayout
  title="About the Guide"
  description="Aichi Reel Guide is a free, independent English travel guide to Nagoya and Aichi, built around short videos by local creators. Here's how we choose spots and work with creators."
  jsonLd={[breadcrumbJsonLd(crumbs, Astro.site)]}
>
  <div class="container-page page-top">
    <Breadcrumbs items={crumbs} />
    <header class="mt-16 max-w-4xl md:mt-24">
      <p class="label label-gold">About</p>
      <h1 class="display-lg mt-6 md:mt-10">A local's-eye view of Aichi</h1>
    </header>
    <div class="section grid gap-12 md:grid-cols-[4fr_7fr] md:gap-16">
      <p class="label label-gold border-t border-line pt-5 md:self-start">The guide</p>
      <div class="prose-guide max-w-xl" data-reveal>
        <p>
          Aichi gets overlooked. Plenty of travellers pass through Nagoya on the bullet train between Tokyo and Kyoto
          without stepping off — and miss one of Japan's great food cities, a National Treasure castle, centuries-old
          pottery towns and an easygoing stretch of coast.
        </p>
        <p>
          Aichi Reel Guide is a free, independent guide in English that aims to change that. The idea is to pair
          each spot with short videos by people who live here, so you can see what a place feels like before you go,
          along with the practical details — hours, access, cards or cash — that make a visit go smoothly.
        </p>
      </div>

      <h2 class="label label-gold border-t border-line pt-5 md:self-start">How we work</h2>
      <div class="prose-guide max-w-xl" data-reveal>
        <p>
          <strong class="font-medium">Videos with permission only.</strong> We never download or re-upload anyone's work. Videos stay on
          Instagram, TikTok or YouTube and are embedded only after the creator has agreed — and nothing loads from
          those platforms until you tap play.
        </p>
        <p>
          <strong class="font-medium">Facts we can stand behind.</strong> If we haven't confirmed an opening time or price, we leave it
          out rather than guess. Each spot shows the date its details were last checked. Things change, so it's always
          worth confirming before a special trip.
        </p>
        <p>
          <strong class="font-medium">No paid placements.</strong> Spots are chosen on merit. The guide is free to use and doesn't require
          an account.
        </p>
      </div>

      {
        SITE.contactEmail && (
          <>
            <h2 id="contact" class="label label-gold scroll-mt-10 border-t border-line pt-5 md:self-start">Contact</h2>
            <div class="prose-guide max-w-xl" data-reveal>
              <p>Spotted something out of date, or you're a creator who'd like to be featured? We'd love to hear from you.</p>
              <p>
                Email us at{' '}
                <a href={`mailto:${SITE.contactEmail}`} class="link-quiet">
                  {SITE.contactEmail}
                </a>
                .
              </p>
            </div>
          </>
        )
      }
    </div>
  </div>
</BaseLayout>
