---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import SpotGrid from '~/components/SpotGrid.astro';
import EmptyState from '~/components/EmptyState.astro';
import SectionHeading from '~/components/SectionHeading.astro';
import { getCategories, getPublishedSpots, type Category } from '~/lib/content';
import { absoluteUrl, breadcrumbJsonLd } from '~/lib/seo';

export const getStaticPaths = (async () => {
  const categories = await getCategories();
  return categories.map((category) => ({ params: { slug: category.id }, props: { category, categories } }));
}) satisfies GetStaticPaths;

interface Props {
  category: Category;
  categories: Category[];
}
const { category, categories } = Astro.props;
const c = category.data;
const spots = (await getPublishedSpots()).filter((s) => s.data.category.id === category.id);
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Categories', href: '/categories/' },
  { label: c.name, href: `/categories/${category.id}/` },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${c.name} in Aichi`,
    description: c.intro_en[0],
    url: absoluteUrl(`/categories/${category.id}/`, Astro.site),
  },
  breadcrumbJsonLd(crumbs, Astro.site),
];
---

<BaseLayout
  title={`${c.name} in Nagoya & Aichi`}
  description={`${c.short_description} The best ${c.name.toLowerCase()} in Nagoya and across Aichi, Japan — picked by locals, with short videos and practical tips.`}
  jsonLd={jsonLd}
>
  <div class="container-page page-top">
    <Breadcrumbs items={crumbs} />
    <header class="mt-16 grid gap-10 md:mt-24 md:grid-cols-[7fr_5fr] md:items-end md:gap-16">
      <div>
        <p class="label label-gold">Category</p>
        <h1 class="display-xl mt-6 md:mt-10">{c.name}</h1>
      </div>
      <div class="prose-guide max-w-md text-ink-soft md:pb-3">
        {c.intro_en.map((p) => <p>{p}</p>)}
      </div>
    </header>

    <section class="section" aria-label={`${c.name} spots`}>
      {
        spots.length > 0 ? (
          <SpotGrid spots={spots} headingLevel="h2" eagerCount={1} />
        ) : (
          <EmptyState title="Coming soon">
            No {c.name.toLowerCase()} spots yet. See <a href="/spots/" class="link-quiet text-ink">all spots</a>.
          </EmptyState>
        )
      }
    </section>

    <nav class="section" aria-labelledby="other-cats">
      <SectionHeading eyebrow="Other categories" id="other-cats" />
      <ul class="flex flex-wrap gap-x-10 gap-y-4">
        {
          categories
            .filter((o) => o.id !== category.id)
            .map((o) => (
              <li>
                <a href={`/categories/${o.id}/`} class="font-display text-[1.75rem] text-ink no-underline transition-colors duration-500 hover:text-gold md:text-[2.25rem]">
                  {o.data.name}
                </a>
              </li>
            ))
        }
      </ul>
    </nav>
  </div>
</BaseLayout>
