---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import SpotGrid from '~/components/SpotGrid.astro';
import EmptyState from '~/components/EmptyState.astro';
import Icon from '~/components/Icon.astro';
import { getCategories, getPublishedSpots, type Category } from '~/lib/content';
import { absoluteUrl, breadcrumbJsonLd } from '~/lib/seo';

export const getStaticPaths = (async () => {
  const categories = await getCategories();
  return categories.map((category) => ({ params: { slug: category.id }, props: { category, categories } }));
}) satisfies GetStaticPaths;

interface Props {
  category: Category;
  categories: Category[];
}
const { category, categories } = Astro.props;
const c = category.data;
const spots = (await getPublishedSpots()).filter((s) => s.data.category.id === category.id);
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Categories', href: '/categories/' },
  { label: c.name, href: `/categories/${category.id}/` },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${c.name} in Aichi`,
    description: c.intro_en[0],
    url: absoluteUrl(`/categories/${category.id}/`, Astro.site),
  },
  breadcrumbJsonLd(crumbs, Astro.site),
];
---

<BaseLayout
  title={`${c.name} in Nagoya & Aichi`}
  description={`${c.short_description} The best ${c.name.toLowerCase()} in Nagoya and across Aichi, Japan — picked by locals, with short videos and practical tips.`}
  jsonLd={jsonLd}
>
  <div class="container-page pt-8 md:pt-12">
    <Breadcrumbs items={crumbs} />
    <header class="mt-8 max-w-3xl">
      <Icon name={c.icon} size={34} class="text-gold" />
      <p class="eyebrow mt-5">Category</p>
      <h1 class="mt-3 text-[3.2rem] md:text-[4.6rem]">{c.name}</h1>
      <div class="prose-guide mt-6 text-ink-soft">
        {c.intro_en.map((p) => <p>{p}</p>)}
      </div>
    </header>

    <section class="mt-16" aria-label={`${c.name} spots`}>
      {
        spots.length > 0 ? (
          <SpotGrid spots={spots} headingLevel="h2" eagerCount={2} />
        ) : (
          <EmptyState title="Coming soon">
            We haven't published any {c.name.toLowerCase()} spots yet. See <a href="/spots/" class="text-ink underline">all spots</a>.
          </EmptyState>
        )
      }
    </section>

    <nav class="mt-20 border-t border-line pt-10" aria-labelledby="other-cats">
      <h2 id="other-cats" class="eyebrow">Other categories</h2>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-3">
        {
          categories
            .filter((o) => o.id !== category.id)
            .map((o) => (
              <li>
                <a href={`/categories/${o.id}/`} class="font-display text-[1.5rem] text-ink no-underline hover:text-gold">
                  {o.data.name}
                </a>
              </li>
            ))
        }
      </ul>
    </nav>
  </div>
</BaseLayout>
