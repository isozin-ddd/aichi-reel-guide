---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import { getCategories } from '~/lib/content';
import { breadcrumbJsonLd } from '~/lib/seo';

const categories = await getCategories();
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Categories', href: '/categories/' },
];
---

<BaseLayout
  title="Things to Do in Aichi by Category"
  description="Food and cafes, culture and history, hands-on experiences, shopping, nature and hidden gems — find things to do in Nagoya and Aichi by category."
  jsonLd={[breadcrumbJsonLd(crumbs, Astro.site)]}
>
  <div class="container-page page-top">
    <Breadcrumbs items={crumbs} />
    <header class="mt-16 md:mt-24">
      <p class="label label-gold">Browse by</p>
      <h1 class="display-lg mt-6 md:mt-10">Categories</h1>
    </header>
    <ul class="section !pt-16 md:!pt-24">
      {
        categories.map((c, i) => (
          <li class="border-t border-line last:border-b" data-reveal>
            <a href={`/categories/${c.id}/`} class="group grid gap-x-10 gap-y-3 py-10 no-underline md:grid-cols-[4rem_5fr_6fr] md:items-baseline md:py-14">
              <span class="label label-gold">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="text-[2.25rem] leading-none transition-colors duration-500 group-hover:text-gold md:text-[3rem]">{c.data.name}</h2>
              <p class="text-body max-w-md">{c.data.short_description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
