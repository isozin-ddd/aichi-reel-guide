---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Icon from '~/components/Icon.astro';
import { getCategories } from '~/lib/content';
import { breadcrumbJsonLd } from '~/lib/seo';

const categories = await getCategories();
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Categories', href: '/categories/' },
];
---

<BaseLayout
  title="Things to Do in Aichi by Category"
  description="Food and cafes, culture and history, hands-on experiences, shopping, nature and hidden gems — find things to do in Nagoya and Aichi by category."
  jsonLd={[breadcrumbJsonLd(crumbs, Astro.site)]}
>
  <div class="container-page pt-8 md:pt-12">
    <Breadcrumbs items={crumbs} />
    <header class="mt-6 max-w-2xl">
      <p class="eyebrow">What are you into?</p>
      <h1 class="mt-3 text-[3rem] md:text-[4.2rem]">Categories</h1>
    </header>
    <ul class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((c) => (
          <li class="bg-paper">
            <a href={`/categories/${c.id}/`} class="flex h-full flex-col gap-4 p-8 no-underline transition-colors hover:bg-ivory">
              <Icon name={c.data.icon} size={28} class="text-gold" />
              <h2 class="text-[2rem] text-ink">{c.data.name}</h2>
              <p class="text-[0.95rem] leading-relaxed text-ink-soft">{c.data.intro_en[0]}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
