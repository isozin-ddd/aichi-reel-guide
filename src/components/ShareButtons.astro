---
import Icon from './Icon.astro';
interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;
const btn =
  'inline-flex min-h-11 items-center gap-2 border border-line bg-paper px-4 text-xs font-semibold tracking-[0.12em] text-ink uppercase hover:border-gold';
---

<share-buttons class="flex flex-wrap items-center gap-2" data-url={url} data-title={title}>
  <span class="mr-1 text-xs font-semibold tracking-[0.12em] text-ink-soft uppercase">Share</span>
  <button type="button" class={btn} data-share hidden>
    <Icon name="share" size={15} /> Share
  </button>
  <button type="button" class={btn} data-copy>
    <Icon name="link" size={15} /> <span data-copy-label>Copy link</span>
  </button>
  <span class="sr-only" aria-live="polite" data-announce></span>
</share-buttons>

<script>
  class ShareButtons extends HTMLElement {
    connectedCallback() {
      const url = this.dataset.url ?? location.href;
      const title = this.dataset.title ?? document.title;
      const share = this.querySelector<HTMLButtonElement>('[data-share]');
      const copy = this.querySelector<HTMLButtonElement>('[data-copy]');
      const label = this.querySelector<HTMLElement>('[data-copy-label]');
      const announce = this.querySelector<HTMLElement>('[data-announce]');

      if (share && typeof navigator.share === 'function') {
        share.hidden = false;
        share.addEventListener('click', async () => {
          try {
            await navigator.share({ title, url });
          } catch {
            /* user cancelled */
          }
        });
      }

      copy?.addEventListener('click', async () => {
        let ok = false;
        try {
          await navigator.clipboard.writeText(url);
          ok = true;
        } catch {
          const input = document.createElement('input');
          input.value = url;
          document.body.appendChild(input);
          input.select();
          ok = document.execCommand('copy');
          input.remove();
        }
        if (label) label.textContent = ok ? 'Copied' : 'Copy failed';
        if (announce) announce.textContent = ok ? 'Link copied to clipboard' : 'Could not copy the link';
        setTimeout(() => {
          if (label) label.textContent = 'Copy link';
        }, 2000);
      });
    }
  }
  if (!customElements.get('share-buttons')) customElements.define('share-buttons', ShareButtons);
</script>
