---
/**
 * Section opener: a hairline rule carrying a small label (and optional link),
 * followed by a large, light serif title.
 */
interface Props {
  eyebrow: string;
  title?: string;
  id?: string;
  href?: string;
  linkLabel?: string;
}
const { eyebrow, title, id, href, linkLabel } = Astro.props;
---

<div class="mb-12 md:mb-20" data-reveal>
  <div class="flex items-baseline justify-between gap-6 border-t border-line pt-5">
    <p class="label label-gold" id={title ? undefined : id}>{eyebrow}</p>
    {
      href && (
        <a href={href} class="label no-underline transition-colors duration-500 hover:text-gold">
          {linkLabel ?? 'View all'}
        </a>
      )
    }
  </div>
  {title && <h2 id={id} class="display-md mt-8 md:mt-12">{title}</h2>}
</div>
