---
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  href?: string;
  linkLabel?: string;
}
const { eyebrow, title, id, href, linkLabel } = Astro.props;
---

<div class="mb-8 flex flex-wrap items-end justify-between gap-4 md:mb-10">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={id} class="mt-2 text-[2.1rem] md:text-[2.8rem]">{title}</h2>
  </div>
  {
    href && (
      <a href={href} class="text-xs font-semibold tracking-[0.14em] text-ink uppercase hover:text-gold">
        {linkLabel ?? 'View all'} <span aria-hidden="true">→</span>
      </a>
    )
  }
</div>
