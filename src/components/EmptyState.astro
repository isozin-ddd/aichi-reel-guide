---
interface Props {
  title: string;
  id?: string;
  hidden?: boolean;
}
const { title, id, hidden = false } = Astro.props;
---

<div id={id} hidden={hidden} class="border-y border-line py-16 text-center md:py-24" role="status">
  <p class="display-sm">{title}</p>
  <div class="text-body mx-auto mt-4 max-w-sm"><slot /></div>
</div>
