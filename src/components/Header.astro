---
const path = Astro.url.pathname;
const nav = [
  { href: '/spots/', label: 'Spots' },
  { href: '/map/', label: 'Map' },
  { href: '/about/', label: 'About' },
];
const isActive = (href: string) => path.startsWith(href) || path === href.slice(0, -1);
---

<a
  href="#main"
  class="label sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[1000] focus:bg-ink focus:px-4 focus:py-2 focus:text-ivory"
  >Skip to content</a
>
<header class="border-b border-line">
  <div class="container-page flex h-16 items-center justify-between gap-6 md:h-24">
    <a href="/" class="font-display text-[1.4rem] leading-none text-ink no-underline md:text-[1.75rem]" aria-label="Aichi Reel Guide — home">
      Aichi Reel Guide
    </a>
    <nav aria-label="Main">
      <ul class="flex items-center gap-5 md:gap-12">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'label border-b pb-1 no-underline transition-colors duration-500 hover:text-gold',
                  isActive(item.href) ? 'border-ink !text-ink' : 'border-transparent',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
