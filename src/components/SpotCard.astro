---
import FramedImage from './FramedImage.astro';
import Icon from './Icon.astro';
import { STATUS_LABELS } from '~/lib/format';
import type { Area, Category, Spot } from '~/lib/content';
import { displayableVideos } from '~/lib/content';

interface Props {
  spot: Spot;
  area: Area;
  category: Category;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}

const { spot, area, category, headingLevel: H = 'h3', eager = false } = Astro.props;
const d = spot.data;
const videoCount = displayableVideos(spot).length;
const status = STATUS_LABELS[d.status];
// The summary and highlights stay searchable without being shown on the card.
const searchText = [d.name_en, d.name_ja, d.summary_en, area.data.name, category.data.name, ...d.highlights_en]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---

<article
  class="group relative"
  data-spot-card
  data-reveal
  data-area={area.id}
  data-category={category.id}
  data-search={searchText}
>
  <div class="relative">
    <FramedImage
      src={d.image}
      alt={d.image_alt}
      sizes="(min-width: 1280px) 368px, (min-width: 640px) 45vw, calc(100vw - 48px)"
      widths={[360, 480, 720, 960]}
      aspect="4 / 5"
      loading={eager ? 'eager' : 'lazy'}
      imgClass="transition-opacity duration-700 group-hover:opacity-90"
    />
    {
      videoCount > 0 && (
        <span class="absolute right-4 bottom-4 inline-flex size-9 items-center justify-center rounded-full bg-ivory text-ink">
          <Icon name="play" size={13} strokeWidth={1.6} />
          <span class="sr-only">{videoCount === 1 ? 'Has a video' : `Has ${videoCount} videos`}</span>
        </span>
      )
    }
  </div>
  <p class="label mt-6">
    {area.data.name}<span aria-hidden="true" class="mx-2">·</span>{category.data.name}
    {status && <span class="label-gold"><span aria-hidden="true" class="mx-2">·</span>{status}</span>}
  </p>
  <H class="mt-2 text-[1.75rem] leading-[1.15] md:text-[2rem]">
    <a href={`/spots/${spot.id}/`} class="no-underline transition-colors duration-500 after:absolute after:inset-0 group-hover:text-gold">
      {d.name_en}
    </a>
  </H>
</article>
