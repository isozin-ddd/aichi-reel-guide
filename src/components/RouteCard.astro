---
/**
 * The site's signature: public transport directions as a compact route line.
 * Stops are dots, rides are thick lines in the line's own colour, walks are dotted.
 */
import type { Spot } from '~/lib/content';

type Directions = NonNullable<Spot['data']['directions']>;

interface Props {
  directions: Directions;
  destination: string;
}

const { directions: dir, destination } = Astro.props;
const yen = new Intl.NumberFormat('en-US').format(dir.fare_yen);
const changes = dir.changes === 0 ? 'No changes' : dir.changes === 1 ? '1 change' : `${dir.changes} changes`;
---

<div class="route-card">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-line pb-5">
    <p class="font-display text-[1.5rem] leading-tight md:text-[1.75rem]">
      From {dir.from_en}
    </p>
    <p class="label !text-ink">
      <span>{dir.minutes} min</span>
      <span aria-hidden="true" class="mx-2 text-gold">·</span>
      <span>¥{yen}</span>
      <span aria-hidden="true" class="mx-2 text-gold">·</span>
      <span>{changes}</span>
    </p>
  </div>

  <ol class="route mt-6" aria-label={`Directions from ${dir.from_en} to ${destination}`}>
    {
      dir.legs.map((leg) => {
        if (leg.type === 'stop') {
          return (
            <li class="route-stop">
              <span class="route-dot" aria-hidden="true" />
              <div class="flex flex-wrap items-baseline gap-x-3">
                <span class="text-[1rem] font-medium">{leg.name_en}</span>
                {leg.code && <span class="route-code">{leg.code}</span>}
                {leg.name_ja && (
                  <span lang="ja" class="text-[0.8125rem] text-ink-soft">
                    {leg.name_ja}
                  </span>
                )}
              </div>
              {leg.note_en && <p class="mt-1 text-[0.8125rem] leading-relaxed text-ink-soft">{leg.note_en}</p>}
            </li>
          );
        }
        if (leg.type === 'ride') {
          const details = [
            leg.stops ? `${leg.stops} ${leg.stops === 1 ? 'stop' : 'stops'}` : null,
            leg.minutes ? `${leg.minutes} min` : null,
          ].filter(Boolean);
          return (
            <li class="route-ride" style={`--line: ${leg.color}`}>
              <span class="route-rail" aria-hidden="true" />
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <span class="route-badge" aria-hidden="true">
                  {leg.badge}
                </span>
                <span class="text-[0.9375rem]">{leg.line_en}</span>
                {leg.line_ja && (
                  <span lang="ja" class="text-[0.8125rem] text-ink-soft">
                    {leg.line_ja}
                  </span>
                )}
              </div>
              <p class="mt-1.5 text-[0.875rem]">
                Toward <strong class="font-medium">{leg.toward_en}</strong>
                {details.length > 0 && <span class="text-ink-soft"> · {details.join(' · ')}</span>}
              </p>
              {leg.note_en && <p class="mt-1 text-[0.8125rem] leading-relaxed text-ink-soft">{leg.note_en}</p>}
            </li>
          );
        }
        return (
          <li class="route-walk">
            <span class="route-rail" aria-hidden="true" />
            <p class="text-[0.875rem]">
              <span class="label !text-ink">Walk {leg.minutes} min</span>
              <span class="mt-1 block text-ink-soft">{leg.text_en}</span>
            </p>
          </li>
        );
      })
    }
    <li class="route-stop route-end">
      <span class="route-dot" aria-hidden="true" />
      <span class="text-[1rem] font-medium">{destination}</span>
    </li>
  </ol>

  {
    dir.alternatives.length > 0 && (
      <div class="mt-8">
        <p class="label">Other ways</p>
        <ul class="mt-3">
          {dir.alternatives.map((a) => (
            <li class="border-t border-line py-4 text-[0.875rem]">
              <span class="font-medium">{a.title_en}</span>
              <span class="mt-1 block text-ink-soft">{a.text_en}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>

<style>
  .route {
    --dot: 0.875rem;
    --gutter: 2.25rem;
  }
  .route > li {
    position: relative;
    padding-left: var(--gutter);
  }
  /* Stops: hollow dot; first and last are filled in ink */
  .route-stop {
    padding-block: 0.25rem;
  }
  .route-dot {
    position: absolute;
    left: calc((var(--gutter) - var(--dot)) / 2 - 0.5rem);
    top: 0.5rem;
    width: var(--dot);
    height: var(--dot);
    border-radius: 9999px;
    border: 2px solid var(--color-ink);
    background: var(--color-ivory);
  }
  .route > li:first-child .route-dot,
  .route-end .route-dot {
    background: var(--color-ink);
  }
  /* Rides and walks: a vertical rail between the stops */
  .route-ride,
  .route-walk {
    padding-block: 1rem 1.25rem;
  }
  .route-rail {
    position: absolute;
    left: calc((var(--gutter) - var(--dot)) / 2 - 0.5rem + var(--dot) / 2);
    top: -0.25rem;
    bottom: -0.25rem;
    transform: translateX(-50%);
  }
  .route-ride .route-rail {
    width: 0.375rem;
    border-radius: 9999px;
    background: var(--line);
  }
  .route-walk .route-rail {
    border-left: 2px dotted var(--color-ink-soft);
  }
  .route-badge {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 9999px;
    border: 2px solid var(--line);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
  }
  .route-code {
    border: 1px solid var(--color-line);
    padding: 0.05rem 0.4rem;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
  }
</style>
