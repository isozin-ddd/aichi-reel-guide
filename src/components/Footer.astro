---
import { SITE } from '~/config/site';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-paper">
  <div class="container-page grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr] md:py-16">
    <div>
      <p class="font-display text-2xl">Aichi Reel Guide</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-ink-soft">
        {SITE.tagline} An independent, free guide to Nagoya and the rest of Aichi Prefecture, Japan.
      </p>
    </div>
    <nav aria-label="Footer">
      <p class="eyebrow">Guide</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a class="text-ink hover:text-gold" href="/spots/">All spots</a></li>
        <li><a class="text-ink hover:text-gold" href="/areas/">Areas</a></li>
        <li><a class="text-ink hover:text-gold" href="/categories/">Categories</a></li>
        <li><a class="text-ink hover:text-gold" href="/map/">Map</a></li>
      </ul>
    </nav>
    <div>
      <p class="eyebrow">About</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a class="text-ink hover:text-gold" href="/about/">About us</a></li>
        <li><a class="text-ink hover:text-gold" href="/about/#contact">Contact</a></li>
        <li><a class="text-ink hover:text-gold" href="/privacy/">Privacy Policy</a></li>
        {
          SITE.social.map((s) => (
            <li>
              <a class="text-ink hover:text-gold" href={s.href} rel="me noopener" target="_blank">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <p class="container-page py-6 text-xs text-ink-soft">
      © {year} Aichi Reel Guide. Videos belong to their creators and are shown with permission.
    </p>
  </div>
</footer>
