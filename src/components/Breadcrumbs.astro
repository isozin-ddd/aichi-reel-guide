---
export interface Crumb {
  label: string;
  href: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class="label flex flex-wrap items-center gap-x-3 gap-y-1">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-3">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i === items.length - 1 ? (
            <span aria-current="page" class="text-ink">
              {item.label}
            </span>
          ) : (
            <a href={item.href} class="no-underline transition-colors duration-500 hover:text-gold">
              {item.label}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
