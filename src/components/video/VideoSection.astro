---
/**
 * Renders a spot's permitted videos. Each entry is parsed defensively;
 * anything unsupported becomes a link card (or is skipped if unsafe), so a
 * bad URL in the data can never break the page.
 */
import YouTubeEmbed from './YouTubeEmbed.astro';
import TikTokEmbed from './TikTokEmbed.astro';
import InstagramEmbed from './InstagramEmbed.astro';
import VideoLinkCard from './VideoLinkCard.astro';
import { parseVideoUrl, PLATFORM_LABELS, toSafeHttpsUrl, type ParsedVideo } from '~/lib/video';

interface VideoEntry {
  platform: 'instagram' | 'tiktok' | 'youtube';
  url: string;
  creator_name: string;
  caption_en?: string | undefined;
}
interface Props {
  videos: VideoEntry[];
  spotName: string;
}
const { videos, spotName } = Astro.props;

const items = videos
  .map((v) => ({ entry: v, parsed: parseVideoUrl(v.url, v.platform) }))
  .filter((i) => i.parsed || toSafeHttpsUrl(i.entry.url));

const is = <P extends ParsedVideo['platform']>(p: ParsedVideo | null, platform: P): p is ParsedVideo & { platform: P } =>
  p?.platform === platform;
---

{
  items.length > 0 && (
    <section aria-labelledby="videos-heading" class="mt-20 md:mt-28" data-reveal>
      <h2 id="videos-heading" class="label label-gold border-t border-line pt-5">
        Videos by locals
      </h2>
      <ul class="-mx-6 mt-8 flex snap-x snap-mandatory scroll-px-6 gap-6 overflow-x-auto px-6 pb-4 md:mx-0 md:grid md:grid-cols-2 md:overflow-visible md:px-0 lg:grid-cols-3">
        {items.map(({ entry, parsed }) => (
          <li class="w-[74%] shrink-0 snap-start sm:w-[45%] md:w-auto">
            {is(parsed, 'youtube') ? (
              <YouTubeEmbed video={parsed} creatorName={entry.creator_name} caption={entry.caption_en} spotName={spotName} />
            ) : is(parsed, 'tiktok') ? (
              <TikTokEmbed video={parsed} creatorName={entry.creator_name} caption={entry.caption_en} spotName={spotName} />
            ) : is(parsed, 'instagram') ? (
              <InstagramEmbed video={parsed} creatorName={entry.creator_name} caption={entry.caption_en} spotName={spotName} />
            ) : (
              <VideoLinkCard url={entry.url} creatorName={entry.creator_name} caption={entry.caption_en} />
            )}
          </li>
        ))}
      </ul>
      <p class="mt-6 max-w-md text-[0.8125rem] leading-[1.8] text-ink-soft">
        Shared with each creator's permission and hosted on {Object.values(PLATFORM_LABELS).join(', ')}. Nothing loads until you tap play.
      </p>
    </section>
  )
}
