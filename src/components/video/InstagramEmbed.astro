---
import LazyEmbed from './LazyEmbed.astro';
import type { ParsedVideo } from '~/lib/video';

interface Props {
  video: ParsedVideo & { platform: 'instagram' };
  creatorName: string;
  caption?: string;
  spotName: string;
}
const props = Astro.props;
---

<LazyEmbed {...props} aspect="4 / 5.6" />
