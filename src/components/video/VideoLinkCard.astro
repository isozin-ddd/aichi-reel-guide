---
/**
 * Plain link to the original post. Used for unsupported URLs and as the
 * fallback when an embed fails. Renders nothing if the URL isn't a safe https URL.
 */
import Icon from '../Icon.astro';
import { toSafeHttpsUrl } from '~/lib/video';

interface Props {
  url: string;
  creatorName: string;
  platformLabel?: string;
  caption?: string;
}
const { url, creatorName, platformLabel, caption } = Astro.props;
const safe = toSafeHttpsUrl(url);
const host = safe?.hostname.replace(/^www\./, '');
---

{
  safe && (
    <a
      href={safe.href}
      target="_blank"
      rel="noopener noreferrer nofollow"
      class="group flex h-full min-h-48 flex-col justify-between gap-8 border border-line p-6 no-underline transition-colors duration-500 hover:border-gold"
    >
      <span class="label label-gold">{platformLabel ?? 'Video'}</span>
      <span>
        {caption && <span class="block font-display text-[1.5rem] leading-tight text-ink">{caption}</span>}
        <span class="mt-2 block text-[0.8125rem] text-ink-soft">by {creatorName}</span>
      </span>
      <span class="label inline-flex items-center gap-2 !text-ink group-hover:!text-gold">
        Watch on {platformLabel ?? host}
        <Icon name="external-link" size={12} />
      </span>
    </a>
  )
}
