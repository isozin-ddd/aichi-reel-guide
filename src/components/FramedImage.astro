---
/**
 * Optimised image inside a frame that shows the alt text if the file can't load.
 * A tiny global script (in BaseLayout) adds `.is-broken` on error.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes: string;
  class?: string;
  imgClass?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  aspect?: string;
}

const {
  src,
  alt,
  widths = [400, 640, 960, 1280],
  sizes,
  class: className,
  imgClass,
  loading = 'lazy',
  fetchpriority,
  aspect = '4 / 3',
} = Astro.props;
---

<div class:list={['img-frame', className]} style={`aspect-ratio: ${aspect}`}>
  <Image
    src={src}
    alt={alt}
    widths={widths.filter((w) => w <= src.width)}
    sizes={sizes}
    loading={loading}
    decoding={loading === 'eager' ? 'sync' : 'async'}
    fetchpriority={fetchpriority}
    format="webp"
    quality={78}
    layout="none"
    class={imgClass}
    data-fallback
  />
  <span class="img-fallback" aria-hidden="true">{alt}</span>
</div>
